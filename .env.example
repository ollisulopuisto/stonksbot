# Optional Slack fixture adapter only. Never commit real values.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_IDS=
# Keep no unless you deliberately want DEMO fixtures posted to Slack.
STONKSBOT_ALLOW_FIXTURE_POSTING=no

# Explicit live daily-close mode, opt in only after Slack/data-provider setup.
STONKSBOT_PROVIDER=fixture
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_DAILY_LIMIT=25
# JSON object; choose the exact symbols/currencies you want. Unsupported => no request.
ALPHAVANTAGE_SYMBOL_CURRENCIES={"AAPL":"USD","SPY":"USD"}
# Persistent private directory, not a public web root. One bot process per directory.
STONKSBOT_STATE_DIR=/var/lib/stonksbot

# Selected live mode: personal-only US quotes. Do not enable for other viewers
# or business use without Finnhub written approval. No chart on free quotes.
FINNHUB_API_KEY=
FINNHUB_PERSONAL_USE_CONFIRMED=no
FINNHUB_US_SYMBOL_CURRENCIES={"AAPL":"USD","SPY":"USD"}
FINNHUB_MINUTE_LIMIT=60
# Set STONKSBOT_PROVIDER=finnhub explicitly after confirming rights.
# Keep each provider in its own persistent state directory.
