# Optional Slack fixture adapter only. Never commit real values.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_IDS=
# Keep no unless you deliberately want DEMO fixtures posted to Slack.
STONKSBOT_ALLOW_FIXTURE_POSTING=no

# Explicit live daily-close mode, opt in only after Slack/data-provider setup.
STONKSBOT_PROVIDER=fixture
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_DAILY_LIMIT=25
# JSON object; choose the exact symbols/currencies you want. Unsupported => no request.
ALPHAVANTAGE_SYMBOL_CURRENCIES={"AAPL":"USD","SPY":"USD"}
# Persistent private directory, not a public web root. One bot process per directory.
STONKSBOT_STATE_DIR=/var/lib/stonksbot

# Selected live mode: personal-only US quotes. Do not enable for other viewers
# or business use without Finnhub written approval. No chart on free quotes.
FINNHUB_API_KEY=
FINNHUB_PERSONAL_USE_CONFIRMED=no
FINNHUB_US_SYMBOL_CURRENCIES={"AAPL":"USD","SPY":"USD"}
FINNHUB_MINUTE_LIMIT=60
# Set STONKSBOT_PROVIDER=finnhub explicitly after confirming rights.
# Keep each provider in its own persistent state directory.

# Optional daily chart alongside Finnhub quote; needs Alpha key above and Slack files:write.
STONKSBOT_HISTORY_PROVIDER=alpha-vantage
# State root automatically isolates finnhub/ and alpha-vantage/ child directories.

# Optional personal-only Helsinki .HE routing alongside Finnhub, or select
# STONKSBOT_PROVIDER=eodhd for Helsinki only. No account/key/live test performed.
# Free budget20calls/day TOTAL, including metadata, quote and history calls.
# Set yes only for a sole-user audience allowed by EODHD terms, not shared Slack.
EODHD_ENABLED=no
EODHD_PERSONAL_USE_CONFIRMED=no
EODHD_API_KEY=
EODHD_DAILY_LIMIT=20
EODHD_MINUTE_LIMIT=20

# Replies/cards/charts in channel by default; set thread for previous behavior.
STONKSBOT_REPLY_MODE=channel

# Existing custom Slack emoji names, no colons. Need reactions:write + reinstall.
STONKSBOT_REACTION_OVER=over
STONKSBOT_REACTION_BACK=back

# Configured Alpha-only mode resolves full names via1extra SYMBOL_SEARCH/day/symbol.
# Shared25/day quota; mixed Finnhub+Alpha history doesn't duplicate name search.
ALPHAVANTAGE_RESOLVE_NAMES=yes
# Finnhub names now use exact symbol search, including ETFs (same1extra/day).
FINNHUB_RESOLVE_NAMES=yes
